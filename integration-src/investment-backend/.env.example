# 로컬에서 `uvicorn app.backend.main:app --reload`로 실행할 때 사용하는 예시입니다.
# Docker Compose 환경에서는 저장소 루트의 .env 값을 사용합니다.

# 퀴즈 저장소(MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=investment_db

# 학습 문서 검색(Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=investment_docs

# 로컬 Ollama 기반 RAG. 문서 색인과 서버 질의에 반드시 같은 임베딩 모델을 사용합니다.
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_URL=http://localhost:11434/api/embed
RAG_EMBEDDING_MODEL=embeddinggemma
# CPU 환경의 첫 임베딩 로딩을 고려한 제한 시간(초)
RAG_EMBEDDING_TIMEOUT_SECONDS=180

# RAG 검색 원문만 근거로 답변을 생성하는 로컬 Ollama 채팅 모델입니다.
RAG_LLM_BASE_URL=http://localhost:11434/v1
RAG_LLM_API_KEY=ollama
RAG_LLM_MODEL=qwen3:8b
# CPU 환경에서 첫 응답이 느릴 수 있어 기본 제한 시간을 넉넉히 둡니다.
RAG_LLM_TIMEOUT_SECONDS=180

# 선택 사항: 우측 AI 투자 도우미의 Amazon Lex V2 연동입니다.
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY를 파일에 넣기보다 EC2/ECS IAM 역할을 권장합니다.
# AWS_REGION=ap-northeast-2
# LEX_BOT_ID=
# LEX_BOT_ALIAS_ID=
# LEX_LOCALE_ID=ko_KR

# 선택 사항: "LLM 서빙 방식 비교(AWS)" 메뉴 — 로컬 Ollama를 대체할 3가지 AWS 서빙 방식을
# 켠 것만 화면에서 테스트할 수 있습니다. AWS_REGION은 위 Lex 설정과 공유합니다.
# 1) EC2/ECS + vLLM·Ollama — OpenAI 호환 엔드포인트
# LLM_EC2_BASE_URL=http://<ec2-public-ip>:8000/v1
# LLM_EC2_API_KEY=ollama
# LLM_EC2_MODEL=llama3:latest
# 2) Amazon Bedrock — bedrock-runtime Converse API. 사용 전 모델 액세스 요청이 필요합니다.
# BEDROCK_MODEL_ID=meta.llama3-8b-instruct-v1:0
# 3) Amazon SageMaker JumpStart — 배포한 실시간 추론 엔드포인트 이름
# SAGEMAKER_ENDPOINT_NAME=

# OpenDART 기업·재무 공시 조회용 인증키 (미설정 시 DART API는 503을 반환)
DART_API_KEY=

# 선택 사항: GPU가 있는 환경에서 텍스트-이미지 생성 모델을 바꿀 때만 설정합니다.
# DIFFUSERS_MODEL_ID=runwayml/stable-diffusion-v1-5
